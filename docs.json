{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dorsen Developers",
  "colors": {
    "primary": "#2C87BF",
    "light": "#409BD3",
    "dark": "#2C87BF"
  },
  "favicon": {
    "light": "/images/dorsen-icon.jpeg",
    "dark": "/images/dorsen-icon.jpeg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Telegram Support Channel",
          "icon": "telegram",
          "href": "https://t.me/dorsenlabs"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "tab": "Dorsen Chain"
      },
      {
        "tab": "Changelogs"
      }
    ]
  },
  "logo": {
    "light": "/images/dorsen-icon.jpeg",
    "dark": "/images/dorsen-icon.jpeg",
    "href": "https://docs.dorsen.org"
  },
  "navbar": {
    "links": [
      {
        "href": "https://t.me/dorsenlabs",
        "label": "Get help"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/dorsenofficial",
      "github": "https://github.com/dorsen-labs",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "windows"
  },
  "styling": {
    "eyebrows": "section"
  }
}
