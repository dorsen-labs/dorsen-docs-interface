{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dorsen Developers",
  "colors": {
    "primary": "#2C87BF",
    "light": "#409BD3",
    "dark": "#2C87BF"
  },
  "favicon": {
    "light": "/images/dorsen.svg",
    "dark": "/images/dorsen.svg"
  },
  "logo": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg",
    "href": "https://docs.dorsen.org"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.dorsen.org",
      "description": "Developer documentation for building with Dorsen Chain.",
      "og:title": "Dorsen Developer Docs",
      "og:description": "Build with Dorsen Chain.",
      "og:image": "https://raw.githubusercontent.com/dorsen-labs/dorsen-docs-interface/main/images/docs/docs-meta.jpeg",
      "og:image:type": "image/jpeg",
      "og:type": "website",
      "og:site_name": "Dorsen Documentation",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://raw.githubusercontent.com/dorsen-labs/dorsen-docs-interface/main/images/docs/docs-meta.jpeg",
      "twitter:site": "@dorsenofficial",
      "theme-color": "#000000",
      "referrer": "origin-when-cross-origin"
    },
    "indexing": "all"
  },
  "navigation": {
        "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "Dorsen Chain",
        "groups": [
          {
            "group": "About Dorsen Chain",
            "pages": [
              "dorsen-chain/index"
            ]
          }
        ]
      },
      {
        "tab": "Changelogs",
        "groups": [
          {
            "group": "Changelogs",
            "pages": [
              "changelogs/index"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Telegram Support Channel",
          "icon": "telegram",
          "href": "https://t.me/dorsenlabs"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/dorsen-labs",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://t.me/dorsenlabs",
        "label": "Get help",
        "icon": "discord"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Explore",
      "href": "https://dorsen.org"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/dorsenlabs",
      "x": "https://x.com/dorsenofficial",
      "github": "https://github.com/dorsen-labs",
      "facebook": "https://www.facebook.com/dorsenchain",
      "instagram": "https://www.instagram.com/dorsenlabs",
      "youtube": "https://www.youtube.com/@dorsenlabs"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "windows"
  },
  "styling": {
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search the dorsen developers docs..."
  }
}
